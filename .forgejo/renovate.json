{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "local>jetersen/homelab//.renovate/forgejo.json"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am every weekday"
    ],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "file\\+https://github\\.com/(?<depName>freelensapp/freelens|postfinance/topf|voidzero-dev/vite-plus)/releases/download/v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/[^\"\\s]+"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "file\\+https://github\\.com/(?<depName>dmno-dev/varlock)/releases/download/(?<currentValue>varlock@[0-9]+\\.[0-9]+\\.[0-9]+)/varlock-linux-x64\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^varlock@(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "file\\+https://github\\.com/(?<depName>GloriousEggroll/proton-ge-custom)/releases/download/(?<currentValue>GE-Proton[0-9]+-[0-9]+)/[^\"\\s]+"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^GE-Proton(?<major>\\d+)-(?<minor>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update the T3 Code CLI and AppImage from the same tag",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "t3code-cli = \\{\\s+url = \"file\\+https://github\\.com/pingdotgg/t3code/releases/download/v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/t3-[0-9.]+-linux-x64\\.tar\\.gz\";\\s+flake = false;\\s+\\};\\s+t3code-desktop = \\{\\s+url = \"file\\+https://github\\.com/pingdotgg/t3code/releases/download/v[0-9.]+/T3-Code-x86_64\\.AppImage\""
      ],
      "depNameTemplate": "pingdotgg/t3code",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "git\\+https://github\\.com/(?<depName>[^?]+?)\\.git\\?ref=refs/tags/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)&shallow=1"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "file\\+https://api\\.nuget\\.org/v3-flatcontainer/(?<depName>[^/]+)/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/[^\"\\s]+\\.nupkg"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget",
      "autoReplaceStringTemplate": "file+https://api.nuget.org/v3-flatcontainer/{{{depName}}}/{{{newValue}}}/{{{depName}}}.{{{newValue}}}.nupkg"
    }
  ],
  "packageRules": [
    {
      "description": "Update the Dux desktop applications together; each release supplies its tested QML dependency",
      "matchPackageNames": [
        "duxlabs-dev/dux-shell",
        "duxlabs-dev/dux-greeter",
        "duxlabs-dev/dux-files"
      ],
      "groupName": "Dux desktop",
      "groupSlug": "dux-desktop"
    },
    {
      "description": "Stay on Freelens v2 while the installed Karpenter, FluxCD and Gateway API extensions target its API",
      "matchPackageNames": [
        "freelensapp/freelens"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "flake.nix"
      ],
      "matchDatasources": [
        "github-releases",
        "github-tags",
        "nuget"
      ],
      "postUpgradeTasks": {
        "commands": [
          "nix --extra-experimental-features \"nix-command flakes\" flake lock"
        ],
        "fileFilters": [
          "flake.lock"
        ],
        "executionMode": "branch",
        "installTools": {
          "nix": {}
        }
      }
    },
    {
      "description": "Merge Nix dependency updates after the NixOS build passes",
      "matchFileNames": [
        "flake.nix",
        "nixos/**"
      ],
      "automerge": true
    }
  ]
}
