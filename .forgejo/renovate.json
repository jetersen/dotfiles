{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "local>jetersen/homelab//.renovate/forgejo.json"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am every weekday"
    ],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": [
        "/^nixos/packages/claude-code-manifest\\.json$/",
        "/^nixos/packages/workstation-manifest\\.json$/"
      ],
      "matchStrings": [
        "[{\"depName\": \"anthropics/claude-code\", \"currentValue\": version}, {\"depName\": t3code.repo, \"currentValue\": t3code.version}][currentValue]"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "git\\+https://github\\.com/(?<depName>[^?]+?)\\.git\\?ref=refs/tags/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)&shallow=1"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^nixos/packages/workstation-manifest\\.json$/"
      ],
      "matchStrings": [
        "\"repo\": \"(?<depName>[^\"]+)\",\\s+\"version\": \"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\",\\s+\"sha256\": \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "file\\+https://api\\.nuget\\.org/v3-flatcontainer/(?<depName>[^/]+)/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/[^\"\\s]+\\.nupkg"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget",
      "autoReplaceStringTemplate": "file+https://api.nuget.org/v3-flatcontainer/{{{depName}}}/{{{newValue}}}/{{{depName}}}.{{{newValue}}}.nupkg"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^nixos/packages/workstation-manifest\\.json$/"
      ],
      "matchStrings": [
        "\"repo\": \"(?<depName>dmno-dev/varlock)\",\\s+\"version\": \"(?<currentValue>varlock@[0-9]+\\.[0-9]+\\.[0-9]+)\",\\s+\"sha256\": \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^varlock@(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^nixos/packages/workstation-manifest\\.json$/"
      ],
      "matchStrings": [
        "\"repo\": \"(?<depName>GloriousEggroll/proton-ge-custom)\",\\s+\"version\": \"(?<currentValue>GE-Proton[0-9]+-[0-9]+)\",\\s+\"sha512\": \"(?<currentDigest>[a-f0-9]{128})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^GE-Proton(?<major>\\d+)-(?<minor>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Stay on Freelens v2 while the installed Karpenter, FluxCD and Gateway API extensions target its API",
      "matchPackageNames": [
        "freelensapp/freelens"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "matchPackageNames": [
        "pingdotgg/t3code"
      ],
      "postUpgradeTasks": {
        "commands": [
          "nixos/packages/update-t3code.sh {{newVersion}}"
        ],
        "fileFilters": [
          "nixos/packages/workstation-manifest.json"
        ],
        "executionMode": "update"
      }
    },
    {
      "matchPackageNames": [
        "anthropics/claude-code"
      ],
      "postUpgradeTasks": {
        "commands": [
          "nixos/packages/update-claude-code.sh {{newVersion}}"
        ],
        "fileFilters": [
          "nixos/packages/claude-code-manifest.json"
        ],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags",
        "nuget"
      ],
      "postUpgradeTasks": {
        "commands": [
          "nix --extra-experimental-features \"nix-command flakes\" flake lock"
        ],
        "fileFilters": [
          "flake.lock"
        ],
        "executionMode": "branch",
        "installTools": {
          "nix": {}
        }
      }
    },
    {
      "description": "Merge Nix dependency updates after the NixOS build passes",
      "matchFileNames": [
        "flake.nix",
        "nixos/**"
      ],
      "automerge": true
    }
  ]
}
