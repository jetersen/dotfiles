[Unit]
Description=Home DNS with outage-only public fallback
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=dnsdist
Group=dnsdist
ExecStartPre=/usr/bin/dnsdist --check-config -C /etc/homelab-dns/dnsdist.conf
ExecStart=/usr/bin/dnsdist --supervised --disable-syslog -C /etc/homelab-dns/dnsdist.conf
Restart=on-failure
RestartSec=2
LimitNOFILE=16384
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
