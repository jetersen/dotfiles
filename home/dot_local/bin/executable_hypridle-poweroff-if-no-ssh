#!/usr/bin/env bash
set -euo pipefail

has_remote_session() {
  local session

  while read -r session _; do
    [[ -n "${session:-}" ]] || continue

    if loginctl show-session "$session" -p Remote --value 2>/dev/null | grep -qx 'yes'; then
      return 0
    fi
  done < <(loginctl list-sessions --no-legend 2>/dev/null || true)

  return 1
}

has_ssh_who_entry() {
  who 2>/dev/null | awk '$NF ~ /^\(.+\)$/ { found = 1 } END { exit !found }'
}

if has_remote_session || has_ssh_who_entry; then
  systemd-cat -t hypridle-poweroff-if-no-ssh echo "Skipping idle poweroff because an SSH session is active"
  exit 0
fi

systemctl poweroff
