#!/usr/bin/env bash
# Re-attach .git to a working tree synced via Syncthing.
#
# Usage:
#   git-bootstrap [DIR]          Bootstrap a single repository (default: CWD).
#   git-bootstrap --all [ROOT]   Walk ROOT (default: ~/git) and bootstrap every
#                                directory that has a .git-remote sidecar but
#                                no .git entry.
#
# For each target the script runs:
#   git init && git remote add origin <url> && git fetch && git reset --mixed origin/<default>
# leaving the working tree files untouched.
#
# .git-remote is written automatically by the git/gh clone wrappers in
# bashrc / config.fish / powershell profile, and can be backfilled with
# the git-remote-sidecars script.

set -euo pipefail

bootstrap_one() {
    local dir="$1"
    local url
    url=$(<"$dir/.git-remote")
    url="${url//$'\n'/}"
    url="${url//$'\r'/}"

    if [[ -z "$url" ]]; then
        echo "skip $dir: empty .git-remote" >&2
        return 1
    fi

    echo "==> $dir <- $url"
    (
        cd "$dir"
        git init -q
        git remote add origin "$url"

        # Cap the fetch so a hung auth prompt or unreachable host
        # doesn't stall the whole run. GIT_TERMINAL_PROMPT=0 keeps git
        # from asking for credentials interactively; SSH askpass is
        # also disabled so ssh-agent or a passphrase-less key is the
        # only path that succeeds silently. http.postBuffer is bumped
        # to mitigate "unexpected disconnect while reading sideband
        # packet" on large fetches.
        local attempt
        local fetched=0
        for attempt in 1 2 3; do
            if GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=true \
               timeout 300 git \
                 -c http.postBuffer=524288000 \
                 -c http.lowSpeedLimit=1000 \
                 -c http.lowSpeedTime=60 \
                 fetch -q origin; then
                fetched=1
                break
            fi
            echo "  ! fetch attempt $attempt failed, retrying..." >&2
            sleep $((attempt * 2))
        done
        if (( ! fetched )); then
            echo "  ! fetch failed after 3 attempts for $url" >&2
            echo "    leaving .git in place; re-run after fixing auth/reachability" >&2
            return 1
        fi

        # Resolve the remote's real default branch. Prefer a local
        # origin/HEAD symref if fetch populated it; otherwise ask the
        # remote HEAD symref directly. Conventional names are only a
        # fallback because renamed repos can keep stale main/master refs.
        local default=""
        default=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
        if [[ -z "$default" ]]; then
            default=$(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=true \
                      timeout 30 git ls-remote --symref origin HEAD 2>/dev/null \
                      | awk '$1 == "ref:" {sub("^refs/heads/", "", $2); print $2; exit}')
            [[ -n "$default" ]] && git remote set-head origin "$default" >/dev/null 2>&1 || true
        fi
        if [[ -z "$default" ]]; then
            for b in main master trunk develop; do
                if git show-ref --verify --quiet "refs/remotes/origin/$b"; then
                    default="$b"
                    break
                fi
            done
        fi
        if [[ -z "$default" || "$default" == "(unknown)" ]]; then
            echo "  ! could not determine default branch, leaving repo unattached" >&2
            return 1
        fi

        # Avoid `git checkout` here: the working tree already holds the
        # user's files (synced via Syncthing), and checkout would try to
        # overwrite them with the remote tip, which fails when contents
        # differ. Instead, create/repoint the branch ref purely in .git
        # and then do a --mixed reset so only HEAD and the index move.
        if ! git show-ref --verify --quiet "refs/heads/$default"; then
            git branch --track "$default" "origin/$default"
        fi
        git symbolic-ref HEAD "refs/heads/$default"
        git reset --mixed "origin/$default"
    )
}

bootstrap_target() {
    local dir="$1"

    if [[ ! -d "$dir" ]]; then
        echo "git-bootstrap: $dir does not exist" >&2
        return 1
    fi

    if [[ -e "$dir/.git" || -L "$dir/.git" ]]; then
        echo "git-bootstrap: $dir already has .git, nothing to do" >&2
        return 0
    fi

    if [[ ! -f "$dir/.git-remote" ]]; then
        echo "git-bootstrap: $dir has no .git-remote sidecar" >&2
        return 1
    fi

    bootstrap_one "$dir"
}

walk_root() {
    local root="$1"

    if [[ ! -d "$root" ]]; then
        echo "git-bootstrap: $root does not exist" >&2
        return 1
    fi

    local found=0
    while IFS= read -r -d '' marker; do
        local dir
        dir="$(dirname "$marker")"
        if [[ -e "$dir/.git" || -L "$dir/.git" ]]; then
            continue
        fi
        found=1
        bootstrap_one "$dir" || echo "  ! failed: $dir" >&2
    done < <(find "$root" -type f -name .git-remote -print0)

    if (( ! found )); then
        echo "Nothing to bootstrap under $root."
    fi
}

case "${1:-}" in
    --all)
        walk_root "${2:-$HOME/git}"
        ;;
    -h|--help)
        sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        bootstrap_target "${1:-$PWD}"
        ;;
esac
