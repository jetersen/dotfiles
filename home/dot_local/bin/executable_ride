#!/usr/bin/env bash
set -euo pipefail

path="${1:-.}"
file=""

if [[ -f "$path" ]]; then
  file="$path"
else
  for ext in slnx slnf sln csproj; do
    file=$(fd --ignore-case --no-ignore --absolute-path --max-depth 3 --max-results 1 --threads 1 --type file --extension "$ext" . "$path")
    [[ -n "$file" ]] && break
  done
fi

target="${file:-.}"
echo "$target"
nohup rider "$target" >/dev/null 2>&1 &
