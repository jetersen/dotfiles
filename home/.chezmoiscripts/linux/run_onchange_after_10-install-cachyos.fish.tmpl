{{ if eq .chezmoi.osRelease.id "cachyos" -}}
#!/usr/bin/env fish

echo "Going to ask for sudo password to install packages"
if sudo -v
  echo "Thanks!"
else
  echo "Sudo password is required to proceed."
  exit 1
end

if not command -q yay
  echo "Installing yay..."
  sudo pacman -Sq --needed --noconfirm yay
end

{{ if .packages.arch.remove -}}
# Remove packages no longer wanted before installing replacements
set packages_to_remove (pacman -Qq {{ .packages.arch.remove | join " " }} 2>/dev/null)
if test (count $packages_to_remove) -gt 0
  echo "Removing unwanted packages..."
  yay -Rns --noconfirm $packages_to_remove
end

{{ end -}}
# Install pacman packages
set pacman_packages {{ .packages.arch.pacman | join " " }}
{{ if .isPersonal -}}
set pacman_packages $pacman_packages {{ .packages.arch.personal.pacman | join " " }}
{{ end -}}
echo "Installing pacman packages..."
sudo pacman -Sq --needed --noconfirm --ask 4 $pacman_packages

# Install AUR packages
set aur_packages {{ .packages.arch.aur | join " " }}
{{ if .isPersonal -}}
set aur_packages $aur_packages {{ .packages.arch.personal.aur | join " " }}
{{ end -}}
echo "Installing AUR packages..."
yay -Sq --needed --noconfirm --overwrite="*" $aur_packages

# Update all packages
echo "Updating all packages..."
yay -Syu --noconfirm

# Create sensitive directories
echo "Creating sensitive directories..."
for dir in ~/.ssh ~/.aws ~/.kube ~/.local
  mkdir -p -m 700 $dir
end

# Create general directories
echo "Creating general directories..."
for dir in ~/.local/bin ~/git
  mkdir -p -m 751 $dir
end

echo "Setup complete!"
{{ end -}}
