[alias]
	change-remote-to-ssh = !git remote set-url origin $(git remote get-url origin | sed "s#https://github.com/#git@github.com:#")
	cp = cherry-pick
	fix-working-tree = !git rm --cached -r . && git reset --hard
	fixauthor = commit --amend --reset-author --no-edit
	home = config user.email "{{ .personalEmail }}"
	lg = log --graph --pretty=format:'%C(magenta)%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	missing = lg HEAD..main
	new = lg main..HEAD
	normalize = add --renormalize
	oops = commit --amend --no-edit
	p = push
	pf = pushf
	pushf = push --force-with-lease
	rb = rebase
	rba = rebase --abort
	rbc = rebase --continue
	rbs = rebase --skip
	rerun-ci = !git commit -m "Rerun CI" --allow-empty && git push
	s = status
	superoops = !git add -A && git oops && git pushf
	work = config user.email "{{ .workEmail }}"
[help]
	autocorrect = 1
[core]
	autocrlf = input
	editor = code --wait
	excludesfile = ~/.config/git/gitignore
	pager = delta
{{- if eq .chezmoi.os "windows" }}
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	light = false
	navigate = true
[merge]
	conflictStyle = diff3
	ff = only
[diff]
	colorMoved = default
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	forceSignAnnotated = true
	gpgsign = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[fetch]
	prune = true
[rebase]
	autosquash = true
	autoStash = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[user]
	email = {{ .email }}
	name = {{ .name }}
	signingKey = ~/.ssh/id_ed25519.pub
[diff "sopsdiffer"]
	textconv = sops decrypt
[includeIf "hasconfig:remote.*.url:git@github.com:moviestarplanet/**"]
	path = ~/.config/git/config.work
[includeIf "hasconfig:remote.*.url:https://github.com/moviestarplanet/**"]
	path = ~/.config/git/config.work
[includeIf "hasconfig:remote.*.url:git@github.com:moviestarplanet-archives/**"]
	path = ~/.config/git/config.work
[includeIf "hasconfig:remote.*.url:https://github.com/moviestarplanet-archives/**"]
	path = ~/.config/git/config.work
{{- if env "CODESPACES" }}
[includeIf "gitdir/i:/workspaces/"]
	path = ~/.config/git/config.codespaces
{{- end }}
[url "git@github.com:"]
	insteadOf = https://github.com/
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential
{{- if eq .chezmoi.os "windows" }}
{{- $coderabbitMachineID := output "cmd.exe" "/d" "/s" "/c" "git config --global --get coderabbit.machineId 2>NUL || exit /b 0" | trim }}
{{- if $coderabbitMachineID }}
[coderabbit]
	machineId = {{ $coderabbitMachineID }}
{{- end }}
{{- else }}
{{- $coderabbitMachineID := output "sh" "-c" "git config --global --get coderabbit.machineId 2>/dev/null || true" | trim }}
{{- if $coderabbitMachineID }}
[coderabbit]
	machineId = {{ $coderabbitMachineID }}
{{- end }}
{{- end }}
