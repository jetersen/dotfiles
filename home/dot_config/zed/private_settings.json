{
  "autosave": "on_focus_change",
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent": {
    "commit_message_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "commit_message_instructions": "Write a concise imperative commit subject. Add a body only when it clarifies non-obvious context."
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "pi-acp": {
      "default_config_options": {
        "thought_level": "low"
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "languages": {
    "PowerShell": {
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "lsp": {
    "powershell-es": {
      "settings": {
        "powershell": {
          "codeFormatting": {
            "preset": "OTBS"
          }
        }
      }
    }
  },
  "theme_overrides": {
    "DankShell Dark": {
      "hidden": "#a6adc8",
      "tab.active_background": "#45475a"
    },
    "DankShell Light": {
      "hidden": "#5c5f77",
      "tab.active_background": "#ccd0da"
    },
    "DankShell Dark Transparent": {
      "hidden": "#a6adc8",
      "tab.active_background": "#45475a"
    },
    "DankShell Light Transparent": {
      "hidden": "#5c5f77",
      "tab.active_background": "#ccd0da"
    }
  }
}
