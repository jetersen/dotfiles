// ────────────── Keybindings (supplement) ──────────────
// DMS auto-generates the bulk of binds in dms/binds.kdl (shell actions,
// window management, focus, workspaces, sizing, screenshots).
// Only personal extras live here. Keys MUST NOT collide with dms/binds.kdl
// or niri errors on a duplicate binding.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

binds {
  // DMS binds the terminal on Mod+T; keep Mod+Return out of muscle memory too.
  Mod+Return hotkey-overlay-title="Open Terminal: Alacritty" { spawn "alacritty"; }
  Mod+B      hotkey-overlay-title="Open Browser: Zen Browser" { spawn "zen-browser"; }
  Mod+E      hotkey-overlay-title="File Manager: Dolphin" { spawn "dolphin"; }

  // Annotate a clipboard screenshot with Satty (DMS uses bare Print).
  Mod+Print  hotkey-overlay-title="Annotate Clipboard Screenshot: Satty" { spawn-sh "wl-paste --type image/png | satty -f - --copy-command wl-copy --early-exit"; }
}
