// ────────────── Window & Layer Rules ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

window-rule {
  geometry-corner-radius 0
  clip-to-geometry true
}

window-rule {
  match app-id="zen"
  open-on-workspace "browser"
}

window-rule {
  match app-id="Slack"
  open-on-workspace "chat"
}

// Pear Desktop opens on the "music" workspace (pinned to its output in
// layout.kdl). Undocked laptop: that output is absent, so niri falls back.
window-rule {
  match app-id=r#"^com\.github\.th_ch\.youtube_music$"#
  open-on-workspace "music"
}

// Float transient/utility windows.
window-rule {
  match app-id=r#"firefox$"# title="^Picture-in-Picture$"
  match app-id="zoom"
  open-floating true
}

// Battle.net (Wine) spawns a blank "explorer.exe" helper window. niri can't
// hide it, so shrink it to 1x1 and park it in a corner without stealing focus.
window-rule {
  match app-id="explorer.exe"
  open-floating true
  open-focused false
  default-column-width { fixed 1; }
  default-window-height { fixed 1; }
  default-floating-position x=0 y=0 relative-to="bottom-right"
}

// Float DMS / quickshell windows by default.
window-rule {
  match app-id=r#"org.quickshell$"#
  match app-id=r#"com.danklinux.dms$"#
  open-floating true
}

// Let the shell draw the wallpaper behind windows.
layer-rule {
  match namespace="^quickshell$"
  place-within-backdrop true
}
