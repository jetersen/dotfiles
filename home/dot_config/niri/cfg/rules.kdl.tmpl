// ────────────── Window & Layer Rules ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

window-rule {
  geometry-corner-radius 0
  clip-to-geometry true
}

window-rule {
  match app-id="zen"
  open-on-workspace "browser"
}

window-rule {
  match app-id="Slack"
  open-on-workspace "chat"
}

// Pear Desktop opens on the "music" workspace (pinned to its output in
// layout.kdl). Undocked laptop: that output is absent, so niri falls back.
window-rule {
  match app-id=r#"^com\.github\.th_ch\.youtube_music$"#
  open-on-workspace "music"
}

// Float transient/utility windows.
window-rule {
  match app-id=r#"firefox$"# title="^Picture-in-Picture$"
  match app-id="zoom"
  open-floating true
}

// Float DMS / quickshell windows by default.
window-rule {
  match app-id=r#"org.quickshell$"#
  match app-id=r#"com.danklinux.dms$"#
  open-floating true
}

// Let the shell draw the wallpaper behind windows.
layer-rule {
  match namespace="^quickshell$"
  place-within-backdrop true
}
