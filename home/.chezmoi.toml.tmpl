{{/* boolean feature tags */}}
{{- $isWork := false -}}{{/* true if this machine is a work machine */}}
{{- $isPersonal := false -}}{{/* true if this machine should have personal secrets */}}
{{- "" -}}

{{- $hostname := .chezmoi.hostname -}}
{{/* Work secrets require explicit opt-in, including on previously work-only hosts. */}}
{{- $isWork = eq (env "DOTFILES_WORK") "1" -}}
{{- $isPersonal = not $isWork -}}

{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isMacOS := eq .chezmoi.os "darwin" -}}
{{- $isCodespaces := eq (env "CODESPACES") "true" -}}
{{- $isHyprland := eq (env "XDG_CURRENT_DESKTOP") "Hyprland" -}}
{{- $isNiri := eq (env "XDG_CURRENT_DESKTOP") "niri" -}}

{{- $firstname := "Joseph" -}}
{{- $lastname := "Petersen" -}}
{{- $name := printf "%s %s" $firstname $lastname -}}
{{- $githubUsername := "jetersen" -}}
{{- $personalEmail := "me@jetersen.dev" -}}
{{- $workEmail := "jop@moviestarplanet.com" -}}
{{- $email := $personalEmail -}}

{{/* preferred output for Pear Desktop's dedicated workspace (niri).
     Descriptive "make model serial" survives DP connector renumbering.
     Undocked laptop: this output is absent, so the launcher falls back. */}}
{{- $musicOutput := "Lenovo Group Limited LEN P27h-10 0x344D3533" -}}
{{- if $isWork -}}
{{-   $musicOutput = "Dell Inc. DELL P2725D 3S5S864" -}}
{{- end -}}

{{/* preferred output for browser/chat workspaces (niri).
     Undocked laptop: absent, niri falls back to any available output. */}}
{{- $dockOutput := "" -}}
{{- if $isWork -}}
{{-   $dockOutput = "Dell Inc. DELL P2725D 24CRZ64" -}}
{{- end -}}

sourceDir = "{{ .chezmoi.homeDir}}/git/dotfiles/home"

[data]
  firstname = {{ $firstname | quote }}
  lastname = {{ $lastname | quote }}
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  workEmail = {{ $workEmail | quote }}
  personalEmail = {{ $personalEmail | quote }}
  hostname = {{ $hostname | quote }}
  musicOutput = {{ $musicOutput | quote }}
  dockOutput = {{ $dockOutput | quote }}
  githubUsername = {{ $githubUsername | quote }}
  isPersonal = {{ $isPersonal }}
  isWork = {{ $isWork }}
  isWindows = {{ $isWindows }}
  isLinux = {{ $isLinux }}
  isMacOS = {{ $isMacOS }}
  isCodespaces = {{ $isCodespaces }}
  isHyprland = {{ $isHyprland }}
  isNiri = {{ $isNiri }}

[interpreters.ps1]
  command = "pwsh"
  args = ["-NoProfile", "-NoLogo"]

[github]
  refreshPeriod = "12h"
