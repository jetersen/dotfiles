{{/* Patterns match TARGET paths (.config/...), not source names (dot_config/...). */}}
{{/* Never deploy Syncthing conflict copies found in the source tree. */}}
**/*sync-conflict-*

{{ if not .isLinux }}
.chezmoiscripts/linux/**
.local/bin/remote-clip
.local/bin/argocd-remote-sso
.agents/skills/t3-remote-thread
.claude/skills/t3-remote-thread
{{ end }}
{{ if not .isMacOS }}
.chezmoiscripts/macos/**
{{ end }}
{{ if not .isWindows }}
Documents
.chezmoiscripts/windows/**
{{ end }}
{{ if .isWindows }}
.bashrc
.zshrc
.config/fish
.config/yay
.chezmoiscripts/unix/**
Pictures
{{ end }}
{{ if not .isHyprland }}
.config/hypr/config
.config/hypr/hyprland.conf
.config/hypr/noctalia
{{ end }}
{{ if or (not .isLinux) (not .isPersonal) }}
.config/hypr/hypridle.conf
{{ end }}
{{ if not .isNiri }}
.config/niri
.config/DankMaterialShell
.local/bin/niri-focus-self
{{ end }}
{{/* hardware-specific audio device disables — only the rocket desktop */}}
{{ if ne .hostname "rocket" }}
.config/wireplumber
{{ end }}
{{/* Music Assistant companion is managed here only on the CachyOS clients. */}}
{{ if or (not .isLinux) (not (or (eq .hostname "rocket") (eq .hostname "worklaptop"))) }}
.config/music-assistant-companion
{{ end }}

{{/* Personal configurations remain unmanaged when work secrets are not enabled. */}}
{{ if not .isWork }}
.aws/config
.kube/config
.config/varlock/work/.env.schema
{{ end }}
