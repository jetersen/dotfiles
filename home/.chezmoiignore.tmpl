{{/* Patterns match TARGET paths (.config/...), not source names (dot_config/...). */}}
{{ if not .isLinux }}
.chezmoiscripts/linux/**
{{ end }}
{{ if not .isMacOS }}
.chezmoiscripts/macos/**
{{ end }}
{{ if not .isWindows }}
Documents
.chezmoiscripts/windows/**
{{ end }}
{{ if .isWindows }}
.bashrc
.zshrc
.config/fish
.config/yay
Pictures
{{ end }}
{{ if not .isHyprland }}
.config/hypr/config
.config/hypr/hyprland.conf
.config/hypr/noctalia
{{ end }}
{{ if or (not .isLinux) (not .isPersonal) }}
.config/hypr/hypridle.conf
{{ end }}
{{ if not .isNiri }}
.config/niri
.config/DankMaterialShell
.local/bin/niri-focus-self
{{ end }}
{{ if not .isWork }}
.config/kanshi
{{ end }}
{{/* hardware-specific audio device disables — only the rocket desktop */}}
{{ if ne .hostname "rocket" }}
.config/wireplumber
{{ end }}
