root = true
[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2
[gitconfig]
indent_size = 2
indent_style = tab

[nixos/patches/lanzaboote/*.patch]
trim_trailing_whitespace = false

[nixos/patches/t3code/*.patch]
trim_trailing_whitespace = false

[nixos/patches/music-assistant/*.patch]
trim_trailing_whitespace = false
