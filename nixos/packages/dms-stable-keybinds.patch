+// Stable ordering avoids rewriting unchanged keybinds during activation.
+func writeNiriProperties(sb *strings.Builder, properties document.Properties) {
+	keys := make([]string, 0, properties.Len())
+	for key := range properties.Unordered() {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		property := document.Properties{key: properties.Unordered()[key]}
+		sb.WriteString(property.String())
+	}
+}
