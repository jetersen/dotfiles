+    // Exact shortcodes and names must win over incidental keyword matches.
+    function searchRank(entry, query) {
+        const name = entry.name.toLowerCase();
+        const aliases = entry.shortcodes || [];
+        if (name === query || aliases.includes(query) || root.effectiveEmoji(entry).toLowerCase() === query)
+            return 0;
+        if (name.startsWith(query) || aliases.some(alias => alias.startsWith(query)))
+            return 1;
+        if (name.includes(query) || aliases.some(alias => alias.includes(query)))
+            return 2;
+        return 3;
+    }
