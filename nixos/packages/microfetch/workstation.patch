+/// Initialize the upstream environment view from our standard Rust entry point.
+///
+/// # Safety
+/// `argv` must contain argc pointers, a null, and a null-terminated envp array.
+pub unsafe fn run_with_environment(argc: i32, argv: *const *const u8) -> Result<(), Error> {
+  unsafe {
+    init_env(argv.add(argc as usize + 1));
+    run(argc, argv)
+  }
+}
