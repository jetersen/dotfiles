// ────────────── Window & Layer Rules ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

window-rule {
  geometry-corner-radius 0
  clip-to-geometry true
}

window-rule {
  match app-id="zen"
  open-on-workspace "browser"
}

window-rule {
  match app-id="(?i)^slack$"
  match app-id="discord"
  open-on-workspace "chat"
}

// Espanso briefly maps this helper to read Wayland keyboard modifiers on reload.
// Keep keyboard focus enabled: it needs a modifier event before it can close.
window-rule {
  match app-id=r#"^Espanso\.SyncTool$"# title="^Espanso Sync Tool$"
  open-floating true
  opacity 0.0
  focus-ring { off; }
  border { off; }
  shadow { off; }
}

// Float transient/utility windows.
window-rule {
  match app-id=r#"firefox$"# title="^Picture-in-Picture$"
  match app-id="zoom"
  open-floating true
}

// Float DMS / quickshell windows by default.
window-rule {
  match app-id=r#"org.quickshell$"#
  match app-id=r#"^dev\.duxlabs\.shell$"#
  open-floating true
}

// Float file choosers while keeping the main file-manager windows tiled.
window-rule {
  match app-id=r#"^dev\.duxlabs\.files$"# title=r#"^(Open|Save|Select|Upload|Export|Import|Choose)"#
  open-floating true
  // Adapt to laptop displays without filling an ultrawide monitor.
  default-column-width { proportion 0.7; }
  default-window-height { proportion 0.7; }
  max-width 1600
  max-height 1000
}

// Let the shell draw the wallpaper behind windows.
layer-rule {
  match namespace="^quickshell$"
  place-within-backdrop true
}
