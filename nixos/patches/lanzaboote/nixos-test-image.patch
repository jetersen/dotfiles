Test fixture compatibility with the dotfiles NixOS input.
The repart module is enabled by importing it; image.repart.enable was removed.
Request Secure Boot firmware explicitly and assert that it is active.

diff --git a/nix/tests/lanzaboote/common/image.nix b/nix/tests/lanzaboote/common/image.nix
index 81567b9..2d42b71 100644
--- a/nix/tests/lanzaboote/common/image.nix
+++ b/nix/tests/lanzaboote/common/image.nix
@@ -107,7 +107,6 @@ in
   system.build.espFiles = espFiles;
 
   image.repart = {
-    enable = true;
     name = config.system.name;
     mkfsOptions = {
       # Makes the build significantly faster by slimming down the images.
@@ -164,5 +163,6 @@ in
     useDefaultFilesystems = false;
 
     useEFIBoot = true;
+    useSecureBoot = true;
   };
 }

diff --git a/nix/tests/lanzaboote/system-profiles.nix b/nix/tests/lanzaboote/system-profiles.nix
--- a/nix/tests/lanzaboote/system-profiles.nix
+++ b/nix/tests/lanzaboote/system-profiles.nix
@@ -91,6 +91,7 @@
         t.assertIn(f"{key} {entry['id']}", loader_conf)
 
       machine.wait_for_unit("multi-user.target")
+      t.assertIn("Secure Boot: enabled (user)", machine.succeed("bootctl status"))
       t.assertEqual(marker(), "system")
 
       # The Nix store of the image is read-only, so nix-env cannot be used.
