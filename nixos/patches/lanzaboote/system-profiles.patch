+        .and_then(|x| x.strip_suffix("-link"))
+        .and_then(|x| x.rsplit_once('-'))
+        .and_then(|(name, version)| Some((name, version.parse::<u64>().ok()?)))
+        .with_context(|| format!("Failed to extract version from: {path:?}"))?;
