@@ -0,0 +1,38 @@
+package cmd
+
+import "github.com/nlewo/comin/pkg/protobuf"
+
+type rebootNotifier struct {
+	title          string
+	lastDeployment string
+	notify         func(string, string) error
+}
+
+func rebootDeployment(event *protobuf.Event) *protobuf.Deployment {
+	var deployment *protobuf.Deployment
+	switch v := event.Type.(type) {
+	case *protobuf.Event_RebootRequired_:
+		deployment = v.RebootRequired.Deployment
+	case *protobuf.Event_ManagerState_:
+		state := v.ManagerState.State
+		if state != nil && state.NeedToReboot.GetValue() && state.Deployer != nil {
+			deployment = state.Deployer.Deployment
+		}
+	}
+	if deployment == nil || deployment.Status != "done" || deployment.Uuid == "" {
+		return nil
+	}
+	return deployment
+}
+
+func (n *rebootNotifier) handle(event *protobuf.Event) error {
+	deployment := rebootDeployment(event)
+	if deployment == nil || deployment.Uuid == n.lastDeployment {
+		return nil
+	}
+	if err := n.notify(n.title+": reboot required", "An update is ready. Reboot to finish applying it."); err != nil {
+		return err
+	}
+	n.lastDeployment = deployment.Uuid
+	return nil
+}
