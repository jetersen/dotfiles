@@ -0,0 +1,65 @@
+package cmd
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/nlewo/comin/pkg/protobuf"
+	"google.golang.org/protobuf/types/known/wrapperspb"
+)
+
+func TestRebootNotifications(t *testing.T) {
+	sent := 0
+	fail := false
+	notifier := rebootNotifier{title: "System update", notify: func(title, message string) error {
+		if fail {
+			return errors.New("notification daemon is not ready")
+		}
+		if title != "System update: reboot required" || message == "" {
+			t.Fatal("missing reboot explanation")
+		}
+		sent++
+		return nil
+	}}
+	deployment := &protobuf.Deployment{Uuid: "first", Status: "done", Operation: "boot"}
+	snapshot := &protobuf.Event{Type: &protobuf.Event_ManagerState_{ManagerState: &protobuf.Event_ManagerState{State: &protobuf.State{
+		NeedToReboot: wrapperspb.Bool(true), Deployer: &protobuf.Deployer{Deployment: deployment},
+	}}}}
+	event := &protobuf.Event{Type: &protobuf.Event_RebootRequired_{RebootRequired: &protobuf.Event_RebootRequired{Deployment: deployment}}}
+	// A pending update is visible at login, without waiting for a new deployment.
+	if err := notifier.handle(snapshot); err != nil {
+		t.Fatal(err)
+	}
+	if sent != 1 {
+		t.Fatal("pending reboot was not notified at login")
+	}
+	// The initial snapshot and later event must not notify twice, including reconnects.
+	_ = notifier.handle(event)
+	_ = notifier.handle(snapshot)
+	if sent != 1 {
+		t.Fatal("duplicate notification")
+	}
+	deployment.Uuid = "second"
+	fail = true
+	if notifier.handle(event) == nil {
+		t.Fatal("notification failure was swallowed")
+	}
+	fail = false
+	_ = notifier.handle(snapshot)
+	if sent != 2 {
+		t.Fatal("failed notification was not retried")
+	}
+	deployment.Uuid = "failed"
+	deployment.Status = "failed"
+	_ = notifier.handle(event)
+	if sent != 2 {
+		t.Fatal("failed deployment incorrectly requested a reboot")
+	}
+	deployment.Status = "done"
+	snapshot.GetManagerState().State.NeedToReboot = wrapperspb.Bool(false)
+	_ = notifier.handle(snapshot)
+	_ = notifier.handle(&protobuf.Event{})
+	if sent != 2 {
+		t.Fatal("non-reboot state produced a notification")
+	}
+}
