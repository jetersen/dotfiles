+package repository
+
+import (
+	"testing"
+
+	"github.com/go-git/go-git/v5/plumbing"
+	"github.com/nlewo/comin/internal/prometheus"
+	"github.com/nlewo/comin/internal/types"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestRewrittenMainOptIn(t *testing.T) {
+	remoteDir := t.TempDir()
+	remote, err := initRemoteRepostiory(remoteDir, false)
+	assert.NoError(t, err)
+	base := HeadCommitId(remote)
+	old, err := commitFile(remote, remoteDir, "main", "original")
+	assert.NoError(t, err)
+	cfg := types.GitConfig{Path: t.TempDir(), Remotes: []types.Remote{{
+		Name: "origin", URL: remoteDir, Timeout: 30,
+		Branches: types.Branches{Main: types.Branch{Name: "main"}, Testing: types.Branch{Name: "testing"}},
+	}}}
+	r, err := New(cfg, "", prometheus.New())
+	assert.NoError(t, err)
+	r.Fetch([]string{"origin"})
+	assert.NoError(t, r.Update())
+	assert.Equal(t, old, r.RepositoryStatus.SelectedCommitId)
+
+	// Replace the tip with a sibling commit, as an amend or rebase would.
+	assert.NoError(t, remote.Storer.SetReference(plumbing.NewHashReference("refs/heads/main", plumbing.NewHash(base))))
+	rewritten, err := commitFile(remote, remoteDir, "main", "rewritten")
+	assert.NoError(t, err)
+	r.Fetch([]string{"origin"})
+	_ = r.Update()
+	assert.Equal(t, old, r.RepositoryStatus.SelectedCommitId)
+	assert.Contains(t, r.RepositoryStatus.Remotes[0].Main.ErrorMsg, "hard reset")
+
+	t.Setenv("COMIN_ALLOW_REWRITTEN_MAIN", "1")
+	assert.NoError(t, r.Update())
+	assert.Equal(t, rewritten, r.RepositoryStatus.SelectedCommitId)
+	assert.Equal(t, rewritten, r.RepositoryStatus.MainCommitId)
+	assert.Empty(t, r.RepositoryStatus.Remotes[0].Main.ErrorMsg)
+
+	// Opting in for main must not permit an unrelated testing branch.
+	assert.NoError(t, remote.Storer.SetReference(plumbing.NewHashReference("refs/heads/testing", plumbing.NewHash(base))))
+	r.Fetch([]string{"origin"})
+	_ = r.Update()
+	assert.Equal(t, rewritten, r.RepositoryStatus.SelectedCommitId)
+	assert.Contains(t, r.RepositoryStatus.Remotes[0].Testing.ErrorMsg, "hard reset")
+}
